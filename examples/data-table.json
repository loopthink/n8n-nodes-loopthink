{
  "name": "loopthink Runner \u2014 n8n Data Table",
  "nodes": [
    {
      "parameters": {
        "transport": "polling",
        "pollInterval": 2
      },
      "id": "loopthink-runner",
      "name": "loopthink Runner",
      "type": "@loopthink/n8n-nodes-loopthink.loopthinkRunner",
      "typeVersion": 1,
      "position": [
        -60,
        360
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r0",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "dt_customers_index",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dt_customers_index"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "dt_customers_show",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dt_customers_show"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unhandled"
        }
      },
      "id": "route-by-tool",
      "name": "Route by tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        180,
        360
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "<DATA_TABLE_ID>",
          "cachedResultName": "customers"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "gt",
              "keyValue": "={{ $json.params.id_after }}"
            },
            {
              "keyName": "createdAt",
              "condition": "gte",
              "keyValue": "={{ $json.params.created_after }}"
            },
            {
              "keyName": "createdAt",
              "condition": "lte",
              "keyValue": "={{ $json.params.created_before }}"
            },
            {
              "keyName": "country",
              "condition": "ilike",
              "keyValue": "={{ $json.params.country }}"
            }
          ]
        },
        "returnAll": false,
        "limit": "={{ $json.params.limit + 1 }}",
        "orderBy": true,
        "orderByColumn": "id",
        "orderByDirection": "={{ $json.params.sort }}",
        "options": {}
      },
      "id": "read-customers",
      "name": "Read customers",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        420,
        100
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "selected",
        "includeFields": "id, name, country, revenue",
        "assignments": {
          "assignments": []
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        660,
        100
      ],
      "id": "keep-index-fields",
      "name": "Keep index fields"
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "page",
        "status": 200,
        "pageSize": "={{ $('loopthink Runner').first().json.params.limit }}"
      },
      "id": "answer-index",
      "name": "Answer index",
      "type": "@loopthink/n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        900,
        100
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "<DATA_TABLE_ID>",
          "cachedResultName": "customers"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.params.id }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "id": "read-one-customer",
      "name": "Read one customer",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        420,
        380
      ]
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-show",
      "name": "Answer show",
      "type": "@loopthink/n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        660,
        380
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "error",
        "error": "={{ 'No branch for tool \\\"' + $('loopthink Runner').first().json.tool + '\\\"' }}"
      },
      "id": "answer-unhandled",
      "name": "Answer unhandled",
      "type": "@loopthink/n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        420,
        640
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    }
  ],
  "connections": {
    "loopthink Runner": {
      "main": [
        [
          {
            "node": "Route by tool",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by tool": {
      "main": [
        [
          {
            "node": "Read customers",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Read one customer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Answer unhandled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read customers": {
      "main": [
        [
          {
            "node": "Keep index fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep index fields": {
      "main": [
        [
          {
            "node": "Answer index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read one customer": {
      "main": [
        [
          {
            "node": "Answer show",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "executionOrder": "v1"
  }
}
