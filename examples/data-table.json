{
  "name": "loopthink Runner \u2014 n8n Data Table",
  "nodes": [
    {
      "parameters": {
        "transport": "polling",
        "pollInterval": 2,
        "requestTimeout": 30,
        "emitResults": true
      },
      "id": "loopthink-runner",
      "name": "loopthink Runner",
      "type": "n8n-nodes-loopthink.loopthinkRunner",
      "typeVersion": 1,
      "position": [
        -620,
        0
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r0",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "dt_customers_index",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dt_customers_index"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "dt_customers_show",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dt_customers_show"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unhandled"
        }
      },
      "id": "route-by-tool",
      "name": "Route by tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        -380,
        60
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "<DATA_TABLE_ID>",
          "cachedResultName": "customers"
        },
        "returnAll": true,
        "orderBy": true,
        "orderByColumn": "createdAt",
        "orderByDirection": "={{ $('loopthink Runner').first().json.params.sort === 'oldest' ? 'ASC' : 'DESC' }}",
        "options": {}
      },
      "id": "read-customers",
      "name": "Read customers",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -140,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "page",
        "sortBy": "createdAt",
        "sortDirection": "={{ $('loopthink Runner').first().json.params.sort === 'oldest' ? 'asc' : 'desc' }}",
        "offset": "={{ $('loopthink Runner').first().json.params.offset || 0 }}",
        "limit": "={{ $('loopthink Runner').first().json.params.limit || 20 }}",
        "fields": "id, name, country, createdAt",
        "dateFilters": {
          "filters": [
            {
              "field": "createdAt",
              "from": "={{ $('loopthink Runner').first().json.params.created_after || '' }}",
              "to": "={{ $('loopthink Runner').first().json.params.created_before || '' }}"
            },
            {
              "field": "updatedAt",
              "from": "={{ $('loopthink Runner').first().json.params.updated_after || '' }}",
              "to": "={{ $('loopthink Runner').first().json.params.updated_before || '' }}"
            }
          ]
        }
      },
      "id": "page",
      "name": "Page",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        120,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "<DATA_TABLE_ID>",
          "cachedResultName": "customers"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('loopthink Runner').first().json.params.id }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "id": "read-one-customer",
      "name": "Read one customer",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -140,
        100
      ]
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-index",
      "name": "Answer index",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        380,
        -160
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-show",
      "name": "Answer show",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        380,
        100
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "error",
        "error": "={{ 'No branch for tool \\\"' + $('loopthink Runner').first().json.tool + '\\\"' }}"
      },
      "id": "answer-unhandled",
      "name": "Answer unhandled",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        380,
        320
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    }
  ],
  "connections": {
    "loopthink Runner": {
      "main": [
        [],
