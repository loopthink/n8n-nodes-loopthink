{
  "name": "loopthink Runner \u2014 n8n Data Table",
  "nodes": [
    {
      "parameters": {
        "transport": "polling",
        "pollInterval": 2
      },
      "id": "loopthink-runner",
      "name": "loopthink Runner",
      "type": "n8n-nodes-loopthink.loopthinkRunner",
      "typeVersion": 1,
      "position": [
        -680,
        0
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r0",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "dt_customers_index",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dt_customers_index"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "dt_customers_show",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dt_customers_show"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unhandled"
        }
      },
      "id": "route-by-tool",
      "name": "Route by tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        -440,
        60
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "<DATA_TABLE_ID>",
          "cachedResultName": "customers"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "={{ $('loopthink Runner').first().json.params.sort !== 'oldest' ? 'lt' : 'gt' }}",
              "keyValue": "={{ $('loopthink Runner').first().json.params.cursor || ($('loopthink Runner').first().json.params.sort !== 'oldest' ? 9007199254740991 : 0) }}"
            },
            {
              "keyName": "createdAt",
              "condition": "gte",
              "keyValue": "={{ $('loopthink Runner').first().json.params.created_after || '0001-01-01T00:00:00.000Z' }}"
            },
            {
              "keyName": "createdAt",
              "condition": "lte",
              "keyValue": "={{ $('loopthink Runner').first().json.params.created_before || '9999-12-31T00:00:00.000Z' }}"
            },
            {
              "keyName": "updatedAt",
              "condition": "gte",
              "keyValue": "={{ $('loopthink Runner').first().json.params.updated_after || '0001-01-01T00:00:00.000Z' }}"
            },
            {
              "keyName": "updatedAt",
              "condition": "lte",
              "keyValue": "={{ $('loopthink Runner').first().json.params.updated_before || '9999-12-31T00:00:00.000Z' }}"
            }
          ]
        },
        "returnAll": false,
        "limit": "={{ $('loopthink Runner').first().json.params.limit || 20 }}",
        "orderBy": true,
        "orderByColumn": "id",
        "orderByDirection": "={{ $('loopthink Runner').first().json.params.sort !== 'oldest' ? 'DESC' : 'ASC' }}",
        "options": {}
      },
      "id": "read-customers",
      "name": "Read customers",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -180,
        -160
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "items",
        "include": "specifiedFields",
        "fieldsToInclude": "id, name, country, createdAt",
        "options": {}
      },
      "id": "aggregate",
      "name": "Aggregate",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        80,
        -160
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c",
              "name": "nextCursor",
              "type": "string",
              "value": "={{ $json.items.length ? String($json.items[$json.items.length - 1].id) : null }}"
            },
            {
              "id": "m",
              "name": "hasMore",
              "type": "boolean",
              "value": "={{ $json.items.length >= ($('loopthink Runner').first().json.params.limit || 20) }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "envelope",
      "name": "Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        320,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "<DATA_TABLE_ID>",
          "cachedResultName": "customers"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('loopthink Runner').first().json.params.id }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "id": "read-one-customer",
      "name": "Read one customer",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -180,
        120
      ]
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-index",
      "name": "Answer index",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        -160
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-show",
      "name": "Answer show",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        120
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "error",
        "error": "={{ 'No branch for tool \\\"' + $('loopthink Runner').first().json.tool + '\\\"' }}"
      },
      "id": "answer-unhandled",
      "name": "Answer unhandled",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        340
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    }
  ],
  "connections": {
