{
  "name": "loopthink Runner \u2014 internal HTTP API",
  "nodes": [
    {
      "parameters": {
        "transport": "polling",
        "pollInterval": 2
      },
      "id": "loopthink-runner",
      "name": "loopthink Runner",
      "type": "n8n-nodes-loopthink.loopthinkRunner",
      "typeVersion": 1,
      "position": [
        -680,
        0
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r0",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "api_customers_index",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "api_customers_index"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "api_customers_show",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "api_customers_show"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unhandled"
        }
      },
      "id": "route-by-tool",
      "name": "Route by tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        -440,
        60
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=<API_BASE_URL>/customers",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ after: $json.params.cursor || undefined, limit: $json.params.limit || 20, created_after: $json.params.created_after || undefined }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "call-api-list",
      "name": "Call API: list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -180,
        -160
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "items",
        "include": "specifiedFields",
        "fieldsToInclude": "id, name, country, createdAt",
        "options": {}
      },
      "id": "aggregate",
      "name": "Aggregate",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        80,
        -160
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c",
              "name": "nextCursor",
              "type": "string",
              "value": "={{ $json.items.length ? String($json.items[$json.items.length - 1].id) : null }}"
            },
            {
              "id": "m",
              "name": "hasMore",
              "type": "boolean",
              "value": "={{ $json.items.length >= ($('loopthink Runner').first().json.params.limit || 20) }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "envelope",
      "name": "Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        320,
        -160
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=<API_BASE_URL>/customers/{{ $('loopthink Runner').first().json.params.id }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "call-api-one",
      "name": "Call API: one",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -180,
        120
      ]
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-index",
      "name": "Answer index",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        -160
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-show",
      "name": "Answer show",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        120
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "error",
        "error": "={{ 'No branch for tool \\\"' + $('loopthink Runner').first().json.tool + '\\\"' }}"
      },
      "id": "answer-unhandled",
      "name": "Answer unhandled",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        340
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    }
  ],
  "connections": {
    "loopthink Runner": {
      "main": [
        [
          {
            "node": "Route by tool",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by tool": {
      "main": [
        [
          {
            "node": "Call API: list",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Call API: one",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Answer unhandled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call API: list": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Envelope",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envelope": {
      "main": [
        [
          {
            "node": "Answer index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call API: one": {
      "main": [
        [
          {
            "node": "Answer show",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "executionOrder": "v1"
  }
}
