        420,
        120
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner (Postgres CRM)"
        }
      }
    }
  ],
