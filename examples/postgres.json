{
  "name": "loopthink Runner \u2014 Postgres",
  "nodes": [
    {
      "parameters": {
        "transport": "polling",
        "pollInterval": 2
      },
      "id": "loopthink-runner",
      "name": "loopthink Runner",
      "type": "n8n-nodes-loopthink.loopthinkRunner",
      "typeVersion": 1,
      "position": [
        -680,
        0
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r0",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "pg_customers_index",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pg_customers_index"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "pg_customers_show",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pg_customers_show"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unhandled"
        }
      },
      "id": "route-by-tool",
      "name": "Route by tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        -440,
        60
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, name, country, created_at, updated_at\nFROM customers\nWHERE ($1::timestamptz IS NULL OR created_at >= $1::timestamptz)\n  AND ($2::timestamptz IS NULL OR created_at <= $2::timestamptz)\n  AND ($3::timestamptz IS NULL OR updated_at >= $3::timestamptz)\n  AND ($4::timestamptz IS NULL OR updated_at <= $4::timestamptz)\n  AND ($5::timestamptz IS NULL OR (created_at, id) {{ $('loopthink Runner').first().json.params.sort !== 'oldest' ? '<' : '>' }} ($5::timestamptz, $6::int))\nORDER BY created_at {{ $('loopthink Runner').first().json.params.sort !== 'oldest' ? 'DESC' : 'ASC' }}, id {{ $('loopthink Runner').first().json.params.sort !== 'oldest' ? 'DESC' : 'ASC' }}\nLIMIT $7",
        "options": {
          "queryReplacement": "={{ [ $json.params.created_after || null, $json.params.created_before || null, $json.params.updated_after || null, $json.params.updated_before || null, ($json.params.cursor || '').split('|')[0] || null, Number(($json.params.cursor || '').split('|')[1]) || 0, $json.params.limit || 20 ] }}"
        }
      },
      "id": "query-customers",
      "name": "Query customers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -180,
        -160
      ],
      "credentials": {
        "postgres": {
          "id": "<POSTGRES_CREDENTIAL_ID>",
          "name": "CRM Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "selected",
        "includeFields": "id, name, country, revenue",
        "assignments": {
          "assignments": []
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        80,
        -160
      ],
      "id": "keep-index-fields",
      "name": "Keep index fields"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, name, email, iban, country, revenue, created_at, updated_at\nFROM customers\nWHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.params.id ] }}"
        }
      },
      "id": "query-one-customer",
      "name": "Query one customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -180,
        120
      ],
      "credentials": {
        "postgres": {
          "id": "<POSTGRES_CREDENTIAL_ID>",
          "name": "CRM Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "page",
        "status": 200,
        "cursorField": "id",
        "pageSize": "={{ $('loopthink Runner').first().json.params.limit || 20 }}"
      },
      "id": "answer-index",
      "name": "Answer index",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        -160
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "object",
        "status": 200
      },
      "id": "answer-show",
      "name": "Answer show",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        120
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    },
    {
      "parameters": {
        "operation": "result",
        "request": "={{ $('loopthink Runner').first().json }}",
        "respondWith": "error",
        "error": "={{ 'No branch for tool \\\"' + $('loopthink Runner').first().json.tool + '\\\"' }}"
      },
      "id": "answer-unhandled",
      "name": "Answer unhandled",
      "type": "n8n-nodes-loopthink.loopthink",
      "typeVersion": 1,
      "position": [
        580,
        340
      ],
      "credentials": {
        "loopthinkRunnerApi": {
          "id": "<LOOPTHINK_CREDENTIAL_ID>",
          "name": "Loopthink Runner"
        }
      }
    }
  ],
